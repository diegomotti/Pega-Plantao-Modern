{
  "name": "pega-plantao-modern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pega Plantão - Modern (HTML + Tailwind CSS)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "start": "node server.js",
    "dev": "concurrently --kill-others-on-fail \"npm:start\" \"npm:watch:css\"",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "build": "npm run sync:tokens && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "concurrently": "latest",
    "sharp": "^0.35.5",
    "tailwindcss": "latest"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
